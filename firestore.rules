rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Endorsements and attachments collection
    match /endorsements/{endorsementId} {
      allow read, write: if true;
    }
    
    // Custom uploaded credential documents
    match /custom_documents/{docId} {
      allow read, write: if true;
    }

    // Committee evaluations and executive notes
    match /evaluations/{evaluationId} {
      allow read, write: if true;
    }

    // Candidate application activity logs and user interactions
    match /application_activity/{activityId} {
      allow read, write: if true;
    }
  }
}
